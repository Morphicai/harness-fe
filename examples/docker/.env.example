# Copy to .env and fill in:
#   cp .env.example .env

# Required — token shared by every client (browser, plugin, agent) that
# connects to this daemon. Generate one with:
#   openssl rand -base64 24
HARNESS_FE_TOKEN=

# Optional — host string used when the daemon prints outbound URLs (dashboard,
# replay viewer). Defaults to the first non-internal IPv4 detected inside the
# container, which is usually wrong because containers see the bridge network.
# Set this to the docker host's LAN IP or DNS name your team uses.
HARNESS_FE_PUBLIC_HOST=

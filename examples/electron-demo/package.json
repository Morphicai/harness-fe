{
    "name": "harness-fe-electron-demo",
    "version": "0.0.1",
    "private": true,
    "description": "Electron renderer reporting into a solo harness-fe gateway — used to verify rrweb records normally in an Electron (Chromium) renderer (harness-fe#158/#159).",
    "main": "electron/main.cjs",
    "scripts": {
        "dev:renderer": "vite",
        "dev:electron": "wait-on tcp:127.0.0.1:47816 && electron .",
        "dev": "concurrently -k -n vite,electron -c cyan,magenta \"npm:dev:renderer\" \"npm:dev:electron\"",
        "build": "vite build"
    },
    "devDependencies": {
        "@harness-fe/vite": "workspace:*",
        "@types/node": "^22.20.1",
        "concurrently": "^9.1.0",
        "electron": "^33.0.0",
        "typescript": "^5.6.0",
        "vite": "^7.1.0",
        "wait-on": "^8.0.1"
    }
}

{
    "name": "harnessa-fe",
    "version": "0.2.4",
    "private": true,
    "packageManager": "pnpm@9.15.0",
    "description": "The frontend harness for AI agents. Source-aware Vite plugin + MCP daemon + runtime client — lets agents drive any page in the user's real browser with full-stack understanding.",
    "type": "module",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/Morphicai/harnessa-fe.git"
    },
    "homepage": "https://github.com/Morphicai/harnessa-fe#readme",
    "bugs": {
        "url": "https://github.com/Morphicai/harnessa-fe/issues"
    },
    "scripts": {
        "build": "turbo build",
        "typecheck": "turbo typecheck",
        "test": "turbo test",
        "dev": "turbo dev --filter=./packages/* --filter=harnessa-fe-react-demo",
        "start:mcp": "pnpm --filter @harnessa-fe/mcp-server start",
        "restart:mcp": "bash scripts/restart-mcp.sh",
        "demo": "pnpm build && pnpm --filter harnessa-fe-react-demo dev",
        "e2e": "pnpm --filter harnessa-fe-react-demo e2e"
    },
    "devDependencies": {
        "@types/node": "^22.0.0",
        "happy-dom": "^20.9.0",
        "turbo": "^2.9.12",
        "typescript": "^5.6.0"
    },
    "pnpm": {
        "// onlyBuiltDependencies": "Empty allowlist disables ALL install/postinstall scripts in our dependency tree. This is the primary defense against Shai-Hulud style postinstall worms. Add a package here ONLY if its postinstall is required AND audited.",
        "onlyBuiltDependencies": []
    }
}

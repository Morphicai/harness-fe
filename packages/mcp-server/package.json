{
    "name": "@harness-fe/mcp-server",
    "version": "4.0.0-next.4",
    "description": "Unified MCP daemon: stdio MCP for AI agents + WS bridge for Vite plugin and runtime client.",
    "type": "module",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/Morphicai/harness-fe.git",
        "directory": "packages/mcp-server"
    },
    "homepage": "https://github.com/Morphicai/harness-fe#readme",
    "bugs": {
        "url": "https://github.com/Morphicai/harness-fe/issues"
    },
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "bin": {
        "harness-fe": "./dist/bin.js"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "src",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "build": "tsc",
        "postbuild": "node -e \"require('fs').chmodSync('dist/bin.js', 0o755)\"",
        "dev": "tsc --watch --preserveWatchOutput",
        "watch": "tsc --watch --preserveWatchOutput",
        "typecheck": "tsc --noEmit",
        "test": "vitest run"
    },
    "engines": {
        "node": ">=18"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.26.0",
        "@harness-fe/daemon": "workspace:*",
        "@harness-fe/protocol": "workspace:*",
        "ws": "^8.18.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@types/ws": "^8.5.10",
        "fast-check": "^3.22.0",
        "tsx": "^4.22.3",
        "typescript": "^5.6.0",
        "vitest": "^2.1.9"
    },
    "publishConfig": {
        "access": "public"
    }
}

{
    "name": "@morphixai/harnessa-fe.mcp-server",
    "version": "0.1.0",
    "description": "Unified MCP daemon: stdio MCP for AI agents + WS bridge for Vite plugin and runtime client.",
    "type": "module",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/morphixai/harnessa-fe.git",
        "directory": "packages/mcp-server"
    },
    "homepage": "https://github.com/morphixai/harnessa-fe#readme",
    "bugs": {
        "url": "https://github.com/morphixai/harnessa-fe/issues"
    },
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "bin": {
        "harnessa-fe": "./dist/cli.js"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "src",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "build": "tsc",
        "dev": "tsc --watch --preserveWatchOutput",
        "watch": "tsc --watch --preserveWatchOutput",
        "start": "tsx src/cli.ts",
        "typecheck": "tsc --noEmit",
        "test": "vitest run"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.26.0",
        "@morphixai/harnessa-fe.protocol": "workspace:*",
        "rrweb-player": "1.0.0-alpha.4",
        "ws": "^8.18.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@types/ws": "^8.5.10",
        "fast-check": "^3.22.0",
        "tsx": "^4.19.0",
        "typescript": "^5.6.0",
        "vitest": "^2.1.9"
    },
    "publishConfig": {
        "access": "public"
    }
}

{
    "name": "@harness-fe/sandbox",
    "version": "4.3.0",
    "description": "Browser sandbox + interceptor lib — observe and customize fetch / XHR / WebSocket / Storage / Navigation / console / errors with a unified middleware-style API. Used internally by @harness-fe/runtime; standalone-usable by any project (Tanka MF, MorphixAI base, etc.).",
    "type": "module",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/Morphicai/harness-fe.git",
        "directory": "packages/sandbox"
    },
    "homepage": "https://github.com/Morphicai/harness-fe#readme",
    "bugs": {
        "url": "https://github.com/Morphicai/harness-fe/issues"
    },
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "src",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "build": "tsc",
        "dev": "tsc --watch --preserveWatchOutput",
        "watch": "tsc --watch --preserveWatchOutput",
        "typecheck": "tsc --noEmit",
        "test": "vitest run"
    },
    "devDependencies": {
        "fake-indexeddb": "^6.0.0",
        "happy-dom": "^20.9.0",
        "vitest": "^2.1.9",
        "typescript": "^5.6.0"
    },
    "publishConfig": {
        "access": "public"
    },
    "keywords": [
        "sandbox",
        "interceptor",
        "fetch",
        "xhr",
        "websocket",
        "storage",
        "navigation",
        "observability"
    ]
}

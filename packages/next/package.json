{
    "name": "@harness-fe/next",
    "version": "4.0.0-next.6",
    "description": "Next.js integration for Harness-FE. Drop-in <HarnessScript /> server component that loads the runtime client and seeds window config — no webpack hooks, no SWC plugin, works with App Router + Pages Router + webpack + Turbopack.",
    "type": "module",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/Morphicai/harness-fe.git",
        "directory": "packages/next"
    },
    "homepage": "https://github.com/Morphicai/harness-fe#readme",
    "bugs": {
        "url": "https://github.com/Morphicai/harness-fe/issues"
    },
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./script": {
            "types": "./dist/script.d.ts",
            "default": "./dist/script.js"
        },
        "./config": {
            "types": "./dist/config.d.ts",
            "default": "./dist/config.js"
        },
        "./sessionId": {
            "types": "./dist/sessionId.d.ts",
            "default": "./dist/sessionId.js"
        }
    },
    "files": [
        "dist",
        "src",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "build": "tsc",
        "dev": "tsc --watch --preserveWatchOutput",
        "typecheck": "tsc --noEmit"
    },
    "peerDependencies": {
        "@harness-fe/runtime": "workspace:^",
        "@harness-fe/node-runtime": "workspace:^",
        "next": "^13.0.0 || ^14.0.0 || ^15.0.0",
        "react": "^17.0.0 || ^18.0.0 || ^19.0.0"
    },
    "peerDependenciesMeta": {
        "@harness-fe/node-runtime": {
            "optional": true
        }
    },
    "devDependencies": {
        "@types/react": "^18.3.0",
        "@harness-fe/runtime": "workspace:*",
        "@harness-fe/node-runtime": "workspace:*",
        "next": "^15.0.0",
        "react": "^18.3.0",
        "typescript": "^5.6.0"
    },
    "publishConfig": {
        "access": "public"
    },
    "keywords": [
        "harness-fe",
        "next",
        "next.js",
        "app-router",
        "mcp",
        "agent"
    ]
}

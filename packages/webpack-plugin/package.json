{
    "name": "@harness-fe/webpack",
    "version": "4.1.2",
    "description": "Native webpack plugin for Harness-FE: source-aware transforms, runtime injection, and MCP bridge. thread-loader compatible.",
    "type": "module",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/Morphicai/harness-fe.git",
        "directory": "packages/webpack-plugin"
    },
    "homepage": "https://github.com/Morphicai/harness-fe#readme",
    "bugs": {
        "url": "https://github.com/Morphicai/harness-fe/issues"
    },
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./loader": {
            "types": "./dist/loader.d.ts",
            "default": "./dist/loader.js"
        }
    },
    "files": [
        "dist",
        "src",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "build": "tsc",
        "typecheck": "tsc --noEmit",
        "test": "vitest run --passWithNoTests"
    },
    "dependencies": {
        "@harness-fe/protocol": "workspace:*",
        "@harness-fe/unplugin": "workspace:*"
    },
    "optionalDependencies": {
        "@harness-fe/cli": "workspace:*"
    },
    "peerDependencies": {
        "webpack": "^5.0.0"
    },
    "devDependencies": {
        "typescript": "^5.6.0",
        "vitest": "^2.1.9",
        "webpack": "^5.107.2"
    },
    "publishConfig": {
        "access": "public"
    }
}

{
    "name": "@harness-fe/core",
    "version": "4.0.0-next.6",
    "description": "Harness-FE core: transport-agnostic capability API + event store + browser-control bridge + identity/canSee/consent. A pure library with no HTTP/WS server — the gateway owns the front door and drives core via the CoreClient interface.",
    "type": "module",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/Morphicai/harness-fe.git",
        "directory": "packages/core"
    },
    "homepage": "https://github.com/Morphicai/harness-fe#readme",
    "bugs": {
        "url": "https://github.com/Morphicai/harness-fe/issues"
    },
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "src",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "build": "tsc",
        "dev": "tsc --watch --preserveWatchOutput",
        "watch": "tsc --watch --preserveWatchOutput",
        "typecheck": "tsc --noEmit",
        "test": "vitest run"
    },
    "engines": {
        "node": ">=18"
    },
    "dependencies": {
        "@harness-fe/protocol": "workspace:*",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@types/node": "^22.0.0",
        "fast-check": "^3.22.0",
        "tsx": "^4.22.3",
        "typescript": "^5.6.0",
        "vitest": "^2.1.9"
    },
    "publishConfig": {
        "access": "public"
    }
}

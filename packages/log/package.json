{
    "name": "@harnessa-fe/log",
    "version": "0.1.0",
    "description": "Isomorphic structured logger for Harnessa-FE. Works in Server Components, Route Handlers, Server Actions, and Client Components — all events land in the same session timeline.",
    "type": "module",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/Morphicai/harnessa-fe.git",
        "directory": "packages/log"
    },
    "homepage": "https://github.com/Morphicai/harnessa-fe#readme",
    "bugs": {
        "url": "https://github.com/Morphicai/harnessa-fe/issues"
    },
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "src",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "build": "tsc",
        "dev": "tsc --watch --preserveWatchOutput",
        "typecheck": "tsc --noEmit",
        "test": "vitest run"
    },
    "peerDependencies": {
        "@harnessa-fe/node-runtime": ">=0.7.0",
        "@harnessa-fe/runtime": ">=0.6.0",
        "@harnessa-fe/next": ">=0.8.0"
    },
    "peerDependenciesMeta": {
        "@harnessa-fe/node-runtime": {
            "optional": true
        },
        "@harnessa-fe/runtime": {
            "optional": true
        },
        "@harnessa-fe/next": {
            "optional": true
        }
    },
    "devDependencies": {
        "@harnessa-fe/node-runtime": "workspace:*",
        "@harnessa-fe/runtime": "workspace:*",
        "@harnessa-fe/next": "workspace:*",
        "@types/node": "^22.0.0",
        "typescript": "^5.6.0",
        "vitest": "^2.1.9"
    },
    "publishConfig": {
        "access": "public"
    },
    "keywords": [
        "harnessa-fe",
        "logger",
        "isomorphic",
        "next.js",
        "server-components",
        "mcp",
        "agent"
    ]
}

{
    "name": "@harness-fe/log",
    "version": "3.1.0",
    "description": "Isomorphic structured logger for Harness-FE. Works in Server Components, Route Handlers, Server Actions, and Client Components — all events land in the same session timeline.",
    "type": "module",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/Morphicai/harness-fe.git",
        "directory": "packages/log"
    },
    "homepage": "https://github.com/Morphicai/harness-fe#readme",
    "bugs": {
        "url": "https://github.com/Morphicai/harness-fe/issues"
    },
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "browser": {
                "types": "./dist/browser.d.ts",
                "default": "./dist/browser.js"
            },
            "node": {
                "types": "./dist/node.d.ts",
                "default": "./dist/node.js"
            },
            "default": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            }
        },
        "./browser": {
            "types": "./dist/browser.d.ts",
            "default": "./dist/browser.js"
        },
        "./node": {
            "types": "./dist/node.d.ts",
            "default": "./dist/node.js"
        }
    },
    "files": [
        "dist",
        "src",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "build": "tsc",
        "dev": "tsc --watch --preserveWatchOutput",
        "typecheck": "tsc --noEmit",
        "test": "vitest run"
    },
    "devDependencies": {
        "@harness-fe/node-runtime": "workspace:*",
        "@types/node": "^22.0.0",
        "typescript": "^5.6.0",
        "vitest": "^2.1.9"
    },
    "publishConfig": {
        "access": "public"
    },
    "keywords": [
        "harness-fe",
        "logger",
        "isomorphic",
        "next.js",
        "server-components",
        "mcp",
        "agent"
    ]
}

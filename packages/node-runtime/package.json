{
    "name": "@harness-fe/node-runtime",
    "version": "4.0.0-next.6",
    "description": "Node.js server-side SDK for Harness-FE. Captures server errors, console output, and Route Handler traces — links them to the browser session via a shared sessionId.",
    "type": "module",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/Morphicai/harness-fe.git",
        "directory": "packages/node-runtime"
    },
    "homepage": "https://github.com/Morphicai/harness-fe#readme",
    "bugs": {
        "url": "https://github.com/Morphicai/harness-fe/issues"
    },
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./auto": {
            "types": "./dist/auto.d.ts",
            "default": "./dist/auto.js"
        },
        "./auto-edge": {
            "types": "./dist/auto-edge.d.ts",
            "default": "./dist/auto-edge.js"
        }
    },
    "files": [
        "dist",
        "src",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "build": "tsc",
        "dev": "tsc --watch --preserveWatchOutput",
        "typecheck": "tsc --noEmit",
        "test": "vitest run"
    },
    "dependencies": {
        "@harness-fe/protocol": "workspace:*"
    },
    "peerDependencies": {
        "ws": "^8.18.0"
    },
    "peerDependenciesMeta": {
        "ws": {
            "optional": true
        }
    },
    "devDependencies": {
        "@types/node": "^22.0.0",
        "@types/ws": "^8.5.10",
        "typescript": "^5.6.0",
        "vitest": "^2.1.9",
        "ws": "^8.18.0"
    },
    "publishConfig": {
        "access": "public"
    },
    "keywords": [
        "harness-fe",
        "node",
        "server",
        "next.js",
        "mcp",
        "agent",
        "tracing"
    ]
}

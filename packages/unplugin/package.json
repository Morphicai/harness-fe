{
    "name": "@harness-fe/unplugin",
    "version": "4.3.0",
    "description": "Unified build plugin for Harness-FE. Supports Vite, Rspack, esbuild, and Rollup via unplugin. Webpack users should use @harness-fe/webpack (native plugin) instead.",
    "type": "module",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/Morphicai/harness-fe.git",
        "directory": "packages/unplugin"
    },
    "homepage": "https://github.com/Morphicai/harness-fe#readme",
    "bugs": {
        "url": "https://github.com/Morphicai/harness-fe/issues"
    },
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./vite": {
            "types": "./dist/vite.d.ts",
            "default": "./dist/vite.js"
        },
        "./rspack": {
            "types": "./dist/rspack.d.ts",
            "default": "./dist/rspack.js"
        },
        "./esbuild": {
            "types": "./dist/esbuild.d.ts",
            "default": "./dist/esbuild.js"
        },
        "./rollup": {
            "types": "./dist/rollup.d.ts",
            "default": "./dist/rollup.js"
        }
    },
    "files": [
        "dist",
        "src",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "build": "tsc",
        "dev": "tsc --watch --preserveWatchOutput",
        "watch": "tsc --watch --preserveWatchOutput",
        "typecheck": "tsc --noEmit",
        "test": "vitest run"
    },
    "dependencies": {
        "@babel/parser": "^7.29.7",
        "@babel/traverse": "^7.29.7",
        "@babel/types": "^7.29.7",
        "@harness-fe/protocol": "workspace:*",
        "@vue/compiler-dom": "^3.5.39",
        "@vue/compiler-sfc": "^3.5.39",
        "magic-string": "^0.30.21",
        "unplugin": "^2.3.2",
        "ws": "^8.21.0"
    },
    "optionalDependencies": {
        "@harness-fe/cli": "workspace:*"
    },
    "devDependencies": {
        "@types/babel__traverse": "^7.28.0",
        "@types/ws": "^8.5.10",
        "fast-check": "^3.22.0",
        "typescript": "^5.6.0",
        "vite": "^7.1.0",
        "vitest": "^2.1.9"
    },
    "publishConfig": {
        "access": "public"
    }
}

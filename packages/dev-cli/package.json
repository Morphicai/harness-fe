{
    "name": "@harness-fe/dev-cli",
    "version": "4.0.0-next.2",
    "description": "Harness-FE solo dev launcher: one command starts the daemon (loopback) + stdio MCP and prints the agent config. Zero-config glue over @harness-fe/daemon + @harness-fe/mcp-server.",
    "type": "module",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/Morphicai/harness-fe.git",
        "directory": "packages/dev-cli"
    },
    "homepage": "https://github.com/Morphicai/harness-fe#readme",
    "bugs": {
        "url": "https://github.com/Morphicai/harness-fe/issues"
    },
    "main": "dist/cli.js",
    "bin": {
        "harness-fe": "./dist/cli.js"
    },
    "exports": {
        ".": {
            "default": "./dist/cli.js"
        }
    },
    "files": [
        "dist",
        "src",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "build": "tsc",
        "postbuild": "node -e \"require('fs').chmodSync('dist/cli.js', 0o755)\"",
        "dev": "tsc --watch --preserveWatchOutput",
        "watch": "tsc --watch --preserveWatchOutput",
        "start": "tsx src/cli.ts",
        "typecheck": "tsc --noEmit",
        "test": "vitest run --passWithNoTests"
    },
    "engines": {
        "node": ">=18"
    },
    "dependencies": {
        "@harness-fe/daemon": "workspace:*",
        "@harness-fe/mcp-server": "workspace:*",
        "@harness-fe/protocol": "workspace:*"
    },
    "devDependencies": {
        "@types/ws": "^8.5.10",
        "tsx": "^4.22.3",
        "typescript": "^5.6.0",
        "vitest": "^2.1.9"
    },
    "publishConfig": {
        "access": "public"
    }
}

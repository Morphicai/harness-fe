{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ES2022",
        "moduleResolution": "bundler",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "outDir": "dist",
        "declaration": true,
        "noEmit": false,
        "types": ["vitest/globals"]
    },
    "include": ["src/**/*.ts"],
    "exclude": ["src/**/*.test.ts", "dist"]
}

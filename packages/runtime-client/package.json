{
    "name": "@harness-fe/runtime",
    "version": "4.3.1",
    "description": "Browser-side SDK injected into the dev page. Connects to the MCP server via WebSocket and executes commands.",
    "type": "module",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/Morphicai/harness-fe.git",
        "directory": "packages/runtime-client"
    },
    "homepage": "https://github.com/Morphicai/harness-fe#readme",
    "bugs": {
        "url": "https://github.com/Morphicai/harness-fe/issues"
    },
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "src",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "build": "node scripts/gen-version.mjs && tsc",
        "dev": "node scripts/gen-version.mjs && tsc --watch --preserveWatchOutput",
        "watch": "node scripts/gen-version.mjs && tsc --watch --preserveWatchOutput",
        "typecheck": "tsc --noEmit",
        "test": "vitest run"
    },
    "dependencies": {
        "@harness-fe/protocol": "workspace:*",
        "@harness-fe/sandbox": "workspace:^",
        "@zumer/snapdom": "^2.15.0",
        "rrweb": "2.1.0"
    },
    "devDependencies": {
        "@harness-fe/core": "workspace:*",
        "@harness-fe/gateway": "workspace:*",
        "happy-dom": "^20.9.0",
        "typescript": "^5.6.0",
        "vitest": "^2.1.9"
    },
    "publishConfig": {
        "access": "public"
    }
}

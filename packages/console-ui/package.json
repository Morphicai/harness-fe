{
    "name": "@harness-fe/console-ui",
    "version": "4.0.0",
    "description": "React SPA for the Harness-FE gateway console: data face (projects / sessions / replay) + governance face (tokens / servers / audit). Built with Vite + Tailwind, served by @harness-fe/gateway at /console.",
    "type": "module",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/Morphicai/harness-fe.git",
        "directory": "packages/console-ui"
    },
    "homepage": "https://github.com/Morphicai/harness-fe#readme",
    "bugs": {
        "url": "https://github.com/Morphicai/harness-fe/issues"
    },
    "exports": {
        "./package.json": "./package.json",
        "./dist/*": "./dist/*"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "typecheck": "tsc --noEmit",
        "test": "vitest run --passWithNoTests"
    },
    "dependencies": {
        "react": "^18.3.0",
        "react-dom": "^18.3.0",
        "react-router-dom": "^6.30.4"
    },
    "devDependencies": {
        "@testing-library/react": "^16.1.0",
        "happy-dom": "^15.11.0",
        "@types/react": "^18.3.0",
        "@types/react-dom": "^18.3.0",
        "@vitejs/plugin-react": "^4.3.0",
        "autoprefixer": "^10.5.2",
        "postcss": "^8.5.16",
        "tailwindcss": "^3.4.17",
        "typescript": "^5.6.0",
        "vite": "^7.1.0",
        "vitest": "^2.1.9"
    },
    "publishConfig": {
        "access": "public"
    }
}

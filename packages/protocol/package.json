{
    "name": "@harness-fe/protocol",
    "version": "4.0.0-next.12",
    "description": "Shared types + Zod schemas across mcp-server, vite-plugin, runtime-client.",
    "type": "module",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/Morphicai/harness-fe.git",
        "directory": "packages/protocol"
    },
    "homepage": "https://github.com/Morphicai/harness-fe#readme",
    "bugs": {
        "url": "https://github.com/Morphicai/harness-fe/issues"
    },
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "src",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "build": "tsc",
        "dev": "tsc --watch --preserveWatchOutput",
        "watch": "tsc --watch --preserveWatchOutput",
        "typecheck": "tsc --noEmit",
        "test": "vitest run"
    },
    "dependencies": {
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "vitest": "^2.1.9",
        "typescript": "^5.6.0"
    },
    "publishConfig": {
        "access": "public"
    }
}

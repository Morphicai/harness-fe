{
    "name": "@harness-fe/gateway",
    "version": "4.0.0-next.3",
    "description": "Harness-FE governance gateway: token lifecycle + RBAC + audit + token→server routing + dynamic manifest + admin panel. Sits in front of one or more daemons for team/public use. Zero native deps (JSON store + node:crypto scrypt).",
    "type": "module",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/Morphicai/harness-fe.git",
        "directory": "packages/gateway"
    },
    "homepage": "https://github.com/Morphicai/harness-fe#readme",
    "bugs": {
        "url": "https://github.com/Morphicai/harness-fe/issues"
    },
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "bin": {
        "harness-gateway": "./dist/cli.js"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "src",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "build": "tsc && node -e \"require('fs').chmodSync('dist/cli.js', 0o755)\"",
        "dev": "tsc --watch --preserveWatchOutput",
        "typecheck": "tsc --noEmit",
        "test": "vitest run --passWithNoTests"
    },
    "engines": {
        "node": ">=18"
    },
    "dependencies": {
        "@harness-fe/protocol": "workspace:*"
    },
    "devDependencies": {
        "tsx": "^4.22.3",
        "typescript": "^5.6.0",
        "vitest": "^2.1.9",
        "@harness-fe/mcp-server": "workspace:*",
        "@modelcontextprotocol/sdk": "^1.26.0"
    },
    "publishConfig": {
        "access": "public"
    }
}
